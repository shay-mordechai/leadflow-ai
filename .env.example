# LeadFlow AI — Environment Configuration Template
# Copy this file to .env and fill in your production/development secrets.

# --- Core Configuration ---
APP_NAME=LeadFlow AI
APP_ENV=development
SECRET_KEY=change_me_to_a_secure_32_character_minimum_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BASE_URL=http://localhost:8000
ALLOWED_HOSTS=*

# --- Database & Queues ---
DATABASE_URL=postgresql+asyncpg://leadflow:leadflow_secret@db:5432/leadflow_prod
REDIS_URL=redis://127.0.0.1:6379/0
RETENTION_TTL_HOURS=2160

# --- External AI APIs ---
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Telephony Providers ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- Meta / WhatsApp Messaging Bot ---
# Used for inbound/outbound WhatsApp messaging, agentic conversational loops (WF-09),
# and outbound templates/follow-ups (WF-16).
META_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=my_secure_token
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# --- Meta / WhatsApp Admin Bot ---
# Used for WABA and phone asset management, inspection, and configuration tasks (WF-21).
# Falls back to META_ACCESS_TOKEN if unset or empty.
META_ADMIN_ACCESS_TOKEN=

# --- Email (SMTP) & Alerts ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@localhost
MAIL_PORT=587
MAIL_SERVER=smtp-relay.brevo.com
ADMIN_EMAIL=

# --- Billing (Meshulam / Grow) ---
MESHULAM_USER_ID=MOCK_USER
MESHULAM_API_KEY=MOCK_API_KEY
MESHULAM_PAGE_CODE=MOCK_PAGE_CODE

# --- Advanced Features ---
ENABLE_WORKFLOW_GRAPH=false
ENABLE_AWS_SSM=false
